# FreshMart Environment Variables Template

# Frontend (Vite) Environment Variables
# In Vercel Project Settings -> Environment Variables, set VITE_API_URL to your deployed backend URL:
# e.g., VITE_API_URL=https://freshmart-api.vercel.app/api or https://your-backend.render.com/api
VITE_API_URL=http://localhost:5000/api

# Backend (Node / Express) Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=freshmart_secret_jwt_key_2026

# MongoDB Atlas Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xhltzke.mongodb.net/freshmart?retryWrites=true&w=majority
